# auto-store 환경 설정 예시. 복사해서 .env 로 저장하고 값을 채운다.
#
# v3(2026-11-01)부터 설정의 진실은 Supabase 의 계정별 user_settings 다.
# 아래 비용·매칭·스케줄 값은 "첫 로그인 때 user_settings 를 채우는 기본값"이고, 이후는 관리자 화면(DB) 값이 우선한다.
# 지금 돌아가는 URL 즉시 분석 CLI(v2 경로)는 아직 이 파일을 직접 읽는다.

# ── Supabase (DB · 인증 · 스토리지) ──────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                # PC 워커·관리자 웹이 쓰는 키. 로그인 JWT 와 함께 RLS 아래에서 동작
SUPABASE_SERVICE_KEY=             # 마이그레이션·시드 전용. 일상 실행에는 불필요하며 PC 에 두지 않는 것이 원칙
SUPABASE_BUCKET=product-images    # 공개(public) 버킷. 생성 이미지 공개 URL 용
SUPABASE_PUBLIC_BASE=             # 비우면 {SUPABASE_URL}/storage/v1/object/public/{BUCKET}

# ── 로그인 (python -m app.auth login 이 물어본다. 비밀번호는 여기 두지 않는다) ──
APP_LOGIN_EMAIL=                  # 선택. 비우면 실행 시 입력

# ── AI 제공자 선택 ───────────────────────────────────────────
# 텍스트 LLM: openai | claude | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-5                    # 비우면 제공자 기본 모델 (openai: gpt-5, claude: claude-opus-5-5)
# 이미지 생성(모드 C 연출컷): gemini | openai | none
IMAGE_PROVIDER=none
IMAGE_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── API 예산 (원) ────────────────────────────────────────────
MONTHLY_BUDGET_KRW=50000
BUDGET_WARN_RATIO=0.8              # 이 비율 도달 시 텔레그램 경고
BUDGET_EXCEEDED_ACTION=stop_content   # stop_content | warn_only

# ── 배치 스케줄 (관리자에서 변경 가능) ───────────────────────
BATCH_COLLECT_AT=02:00
BATCH_NOTIFY_AT=08:00
BATCH_DAYS=mon,tue,wed,thu,fri,sat,sun
DAILY_CANDIDATE_LIMIT=10           # 아침 카드로 보낼 후보 수
INSTANT_ANALYSIS_DAILY_LIMIT=50    # URL 즉시 분석 하루 상한 (소스 차단·API 비용 방지)

# ── 등록 상품 감시 (관리자에서 변경 가능) ────────────────────
MONITOR_INTERVAL_DAYS=3            # listed 상품의 소스 재점검 주기 (일)
MONITOR_PRICE_THRESHOLD=0.05       # 이 비율 이상 가격 변동 시 알림 (품절·삭제·MOQ 변경은 항상 알림)

# ── 매칭 · 비교 가격 ─────────────────────────────────────────
NAVER_TOP_N=10                     # 검색어당 상위 N개
PRICE_BASIS=mean                   # mean | median | min
SAME_IMAGE_SELLER_CAP=5            # 동일 이미지 판매자 이 수 이상이면 감점
MATCH_PRESET=normal                # strict | normal | wide (세부 임계값은 관리자에서)
BRAND_LOGO_AUTO_EXCLUDE=true

# ── 원가 기본값 (관리자 비용 설정으로 옮겨갈 값) ──────────────
PROXY_FEE_RATE=0.05                # 대리구매 수수료율
LOCAL_SHIPPING_CNY=8               # 중국 내 배송비 기본 (CNY)
CUSTOMS_DUTY_RATE=0.08             # 관세율 (150달러 초과 시)
VAT_RATE=0.10
CUSTOMS_LIMIT_USD=150
CUSTOMS_WARN_USD=130
NAVER_FEE_RATE=0.055
PAYMENT_FEE_RATE=0.02
FX_BUFFER_RATE=0.02                # 환차손 완충
TARGET_MARGIN_RATE=0.30            # 목표 마진율 (제안 판매가 계산)
FORWARDER_RATES=0.5:6000,1:7500,1.5:9000,2:10500,3:13500,5:19500,10:34500   # kg이하:원

# ── 네이버 (선택) ────────────────────────────────────────────
# 쇼핑 검색 API 는 2026-07-31 종료 → 국내 가격은 통합검색 크롤링으로 수집하므로 키가 필요 없다.
# 데이터랩 쇼핑인사이트(수요 신호)를 붙일 때 NAVER API HUB(네이버클라우드) 키를 여기에 넣는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 환율 ─────────────────────────────────────────────────────
EXIMBANK_API_KEY=                  # 없으면 네이버 금융 크롤링으로 대체

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 로컬 경로 (v3 에서 PC 에 남는 것: 브라우저 로그인 프로필, 산출 엑셀 사본, CLIP 모델 캐시) ──
DATA_DIR=./data                    # v2 CLI 의 분석 이력·환율 캐시도 아직 여기 (v3 7단계에서 Supabase 로 이전)
IMAGES_DIR=./images
OUTPUT_DIR=./output
BROWSER_PROFILES_DIR=./data/profiles
