# auto-store 환경 설정 예시. 복사해서 .env 로 저장하고 값을 채운다.
# 관리자 화면(시스템 설정)에서 저장한 값이 있으면 그 값이 여기 값보다 우선한다.

# ── 관리자 로그인 ─────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=                       # 세션 서명과 설정값 암호화에 사용. 긴 무작위 문자열

# ── AI 제공자 선택 ───────────────────────────────────────────
# 텍스트 LLM: claude | gemini | openai
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5-5          # 비우면 제공자 기본 모델
# 이미지 생성(모드 C 연출컷): gemini | openai | none
IMAGE_PROVIDER=none
IMAGE_MODEL=

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# ── API 예산 (원) ────────────────────────────────────────────
MONTHLY_BUDGET_KRW=50000
BUDGET_WARN_RATIO=0.8              # 이 비율 도달 시 텔레그램 경고
BUDGET_EXCEEDED_ACTION=stop_content   # stop_content | warn_only

# ── 배치 스케줄 (관리자에서 변경 가능) ───────────────────────
BATCH_COLLECT_AT=02:00
BATCH_NOTIFY_AT=08:00
BATCH_DAYS=mon,tue,wed,thu,fri,sat,sun
DAILY_CANDIDATE_LIMIT=10           # 아침 카드로 보낼 후보 수

# ── 등록 상품 감시 (관리자에서 변경 가능) ────────────────────
MONITOR_INTERVAL_DAYS=3            # listed 상품의 소스 재점검 주기 (일)
MONITOR_PRICE_THRESHOLD=0.05       # 이 비율 이상 가격 변동 시 알림 (품절·삭제·MOQ 변경은 항상 알림)

# ── 매칭 정확도 ──────────────────────────────────────────────
MATCH_PRESET=normal                # strict | normal | wide (세부 임계값은 관리자에서)
MATCH_EXACT_THRESHOLD=0.80
MATCH_SIMILAR_MIN=0.50
GROUP_THRESHOLD=0.85
BRAND_LOGO_AUTO_EXCLUDE=true

# ── 이미지 스토리지 (Supabase) ───────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=              # service role 키 (서버에서만 사용, 공개 금지)
SUPABASE_BUCKET=product-images     # 공개(public) 버킷
SUPABASE_PUBLIC_BASE=              # 비우면 {SUPABASE_URL}/storage/v1/object/public/{BUCKET}

# ── 네이버 쇼핑 검색 API ─────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 환율 ─────────────────────────────────────────────────────
EXIMBANK_API_KEY=                  # 없으면 네이버 금융 크롤링으로 대체

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 저장 경로 ────────────────────────────────────────────────
DATA_DIR=./data
IMAGES_DIR=./images
OUTPUT_DIR=./output
BROWSER_PROFILES_DIR=./data/profiles
